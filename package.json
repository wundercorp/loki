{
  "name": "@wundercorp/loki",
  "version": "0.21.25",
  "description": "Loki Agent — a self-improving AI agent by WunderCorp, Inc.",
  "private": false,
  "workspaces": [
    "apps/*",
    "tui-ui",
    "tui-ui/packages/*",
    "web",
    "tests-js",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "echo '✅ Node dependencies installed. Run: loki --help (or loki --help)'",
    "install:root": "npm install --workspaces=false",
    "install:web": "npm install --workspace web",
    "install:tui": "npm install --workspace tui-ui",
    "install:desktop": "npm install --workspace apps/desktop",
    "audit:root": "npm audit --workspaces=false",
    "audit:web": "npm audit --workspace web",
    "audit:tui": "npm audit --workspace tui-ui",
    "audit:fix:root": "npm audit fix --workspaces=false",
    "audit:fix:web": "npm audit fix --workspace web",
    "audit:fix:tui": "npm audit fix --workspace tui-ui",
    "check": "npm run check:deps && npm run check:docs && npm run --ws --if-present check",
    "fix": "npm run --ws fix",
    "verify:brand": "node scripts/verify-rebrand.mjs",
    "release:check": "npm run verify:version && npm run verify:lock && npm run verify:brand && npm run verify:package",
    "prepublishOnly": "npm run verify:version && npm run verify:brand",
    "deploy:all": "bash scripts/deploy.sh",
    "deploy:site": "bash scripts/deploy-site.sh",
    "deploy:npm": "bash scripts/deploy.sh --npm-only",
    "site:start": "npm --prefix website start",
    "site:build": "npm --prefix website run build",
    "site:generate": "npm --prefix website run generate",
    "verify:lock": "node scripts/verify-package-lock.mjs",
    "verify:version": "python3 scripts/sync_version.py verify",
    "verify:package": "node scripts/verify-package-contents.mjs",
    "check:docs": "npm --prefix website test",
    "check:quick": "npm run typecheck --workspace apps/shared && npm run typecheck --workspace apps/desktop && npm run typecheck --workspace tui-ui && npm run typecheck --workspace web && npm run test --workspace tests-js && npm run test --workspace web -- src/components/OAuthLoginModal.test.tsx src/pages/SessionsPage.test.tsx && npm run lint --workspace apps/shared && npm run lint --workspace apps/desktop",
    "check:deps": "node scripts/check-unused-workspace-deps.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wundercorp/loki.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/wundercorp/loki/issues"
  },
  "homepage": "https://loki.computer",
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "typescript-eslint": "8.64.0",
    "eslint-plugin-perfectionist": "5.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "17.7.0",
    "hermes-parser": "0.25.1"
  },
  "overrides": {
    "lodash": "4.18.1",
    "yauzl": "^3.3.1",
    "protobufjs": "^8.7.1",
    "brace-expansion": "5.0.9",
    "mermaid": "11.16.1",
    "dompurify": "3.4.13",
    "ip-address": "10.3.1",
    "nanoid@^3": "3.3.18",
    "nanoid@^6": "6.0.0",
    "js-yaml@^4": "4.3.1",
    "undici@^6": "6.28.0",
    "undici@^7": "7.29.0",
    "postcss": "8.5.23",
    "tar": "7.5.22"
  },
  "engines": {
    "node": "^22.22.0 || ^24.11.0 || >=26.0.0",
    "npm": "<11.10.0 || >=11.17.0"
  },
  "allowScripts": {
    "unicode-animations": false,
    "esbuild@0.28.1": true,
    "node-pty@1.1.0": true,
    "electron-winstaller@5.4.0": true,
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true,
    "get-windows@9.3.0": true,
    "electron@41.10.7": true
  },
  "bin": {
    "loki": "loki"
  },
  "files": [
    "loki",
    "loki",
    "loki_cli/**",
    "agent/**",
    "tools/**",
    "gateway/**",
    "cron/**",
    "providers/**",
    "plugins/**",
    "skills/**",
    "optional-skills/**",
    "optional-mcps/**",
    "locales/**",
    "*.py",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "!**/__pycache__/**",
    "!**/*.pyc",
    "!**/*.pyo",
    "!**/*.pyd",
    "!**/*.egg-info/**",
    "!MagicMock/**",
    "!svg/**"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "loki",
    "ai",
    "ai-agent",
    "agent",
    "autonomous-agent",
    "coding-agent",
    "cli",
    "terminal",
    "llm",
    "automation",
    "mcp",
    "tool-use",
    "developer-tools",
    "wundercorp"
  ]
}
